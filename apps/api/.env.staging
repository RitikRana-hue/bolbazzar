# Staging Environment Configuration
NODE_ENV=staging

# Database Configuration
DATABASE_URL=postgresql://instasell_staging:CHANGE_ME@staging-db:5432/instasell_staging
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_ACQUIRE_TIMEOUT_MS=60000

# Redis Configuration
REDIS_URL=redis://staging-redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_KEY_PREFIX=instasell:staging:

# JWT Configuration
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=instasell-staging
JWT_AUDIENCE=instasell-staging-users

# Server Configuration
PORT=3001
HOST=0.0.0.0
API_URL=https://api-staging.instasell.com
FRONTEND_URL=https://staging.instasell.com
CORS_ORIGINS=https://staging.instasell.com
TRUST_PROXY=true
BODY_LIMIT=10mb
SERVER_TIMEOUT_MS=30000

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=30
SESSION_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING
SESSION_MAX_AGE=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false

# Payment Configuration (Test Keys)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.CHANGE_ME
FROM_EMAIL=noreply@staging.instasell.com
FROM_NAME=InstaSell Staging

# File Upload Configuration
FILE_UPLOAD_PROVIDER=aws
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_PRODUCT=10
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_BUCKET_NAME=instasell-staging-uploads
AWS_REGION=us-east-1
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Auction Configuration
AUCTION_MIN_DURATION_HOURS=1
AUCTION_MAX_DURATION_HOURS=168
AUCTION_EXTENSION_TIME_SECONDS=300
AUCTION_BID_INCREMENT_MIN=1.00
AUCTION_AUTO_END_CHECK_INTERVAL_MS=60000

# Escrow Configuration
ESCROW_HOLDING_DAYS=7
PLATFORM_COMMISSION_RATE=0.05
ESCROW_AUTO_RELEASE_CHECK_INTERVAL_MS=3600000

# Logging Configuration
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=false
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring Configuration
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_AUCTIONS=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_DELIVERY_TRACKING=true