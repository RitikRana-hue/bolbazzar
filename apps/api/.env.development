# Development Environment Configuration
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://instasell:instasell_dev@localhost:5432/instasell
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instasell
DB_USER=instasell
DB_PASSWORD=instasell_dev
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_ACQUIRE_TIMEOUT_MS=60000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_KEY_PREFIX=instasell:dev:

# JWT Configuration
JWT_SECRET=instasell-development-jwt-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=instasell-dev
JWT_AUDIENCE=instasell-dev-users

# Server Configuration
PORT=3001
HOST=0.0.0.0
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
BODY_LIMIT=10mb
SERVER_TIMEOUT_MS=30000

# Security Configuration
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=6
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_TIME_MINUTES=15
SESSION_SECRET=instasell-dev-session-secret-key
SESSION_MAX_AGE=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESS=true

# Payment Configuration (Test Keys)
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Email Configuration (Development)
EMAIL_PROVIDER=console
FROM_EMAIL=dev@instasell.local
FROM_NAME=InstaSell Development

# File Upload Configuration
FILE_UPLOAD_PROVIDER=local
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_PRODUCT=10
LOCAL_UPLOAD_DIR=./uploads
LOCAL_UPLOAD_BASE_URL=/uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Auction Configuration
AUCTION_MIN_DURATION_HOURS=1
AUCTION_MAX_DURATION_HOURS=168
AUCTION_EXTENSION_TIME_SECONDS=300
AUCTION_BID_INCREMENT_MIN=1.00
AUCTION_AUTO_END_CHECK_INTERVAL_MS=60000

# Escrow Configuration
ESCROW_HOLDING_DAYS=7
PLATFORM_COMMISSION_RATE=0.05
ESCROW_AUTO_RELEASE_CHECK_INTERVAL_MS=3600000

# Logging Configuration
LOG_LEVEL=debug
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=true

# Monitoring Configuration
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000
ENABLE_METRICS=false

# Feature Flags
ENABLE_AUCTIONS=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_DELIVERY_TRACKING=true