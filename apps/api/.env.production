# Production Environment Configuration
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://instasell_prod:CHANGE_ME_SECURE_PASSWORD@prod-db:5432/instasell_prod
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_ACQUIRE_TIMEOUT_MS=60000

# Redis Configuration
REDIS_URL=redis://prod-redis:6379
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=instasell:prod:

# JWT Configuration
JWT_SECRET=CHANGE_ME_TO_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=instasell
JWT_AUDIENCE=instasell-users

# Server Configuration
PORT=3001
HOST=0.0.0.0
API_URL=https://api.instasell.com
FRONTEND_URL=https://instasell.com
CORS_ORIGINS=https://instasell.com,https://www.instasell.com
TRUST_PROXY=true
BODY_LIMIT=10mb
SERVER_TIMEOUT_MS=30000

# Security Configuration
BCRYPT_ROUNDS=14
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_TIME_MINUTES=60
SESSION_SECRET=CHANGE_ME_TO_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING
SESSION_MAX_AGE=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_SKIP_SUCCESS=false

# Payment Configuration (Live Keys)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.CHANGE_ME
FROM_EMAIL=noreply@instasell.com
FROM_NAME=InstaSell Marketplace

# File Upload Configuration
FILE_UPLOAD_PROVIDER=aws
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_PRODUCT=10
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_BUCKET_NAME=instasell-prod-uploads
AWS_REGION=us-east-1
AWS_CDN_URL=https://cdn.instasell.com
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Auction Configuration
AUCTION_MIN_DURATION_HOURS=1
AUCTION_MAX_DURATION_HOURS=168
AUCTION_EXTENSION_TIME_SECONDS=300
AUCTION_BID_INCREMENT_MIN=1.00
AUCTION_AUTO_END_CHECK_INTERVAL_MS=30000

# Escrow Configuration
ESCROW_HOLDING_DAYS=7
PLATFORM_COMMISSION_RATE=0.05
ESCROW_AUTO_RELEASE_CHECK_INTERVAL_MS=1800000

# Logging Configuration
LOG_LEVEL=warn
LOG_CONSOLE_ENABLED=false
LOG_CONSOLE_COLORIZE=false
LOG_FILE_PATH=/var/log/instasell/app.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=10

# Monitoring Configuration
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_AUCTIONS=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_DELIVERY_TRACKING=true