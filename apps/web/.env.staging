# Staging Environment Configuration
NODE_ENV=staging

# API Configuration
NEXT_PUBLIC_API_URL=https://api-staging.instasell.com/api
NEXT_PUBLIC_WS_URL=wss://api-staging.instasell.com
NEXT_PUBLIC_SOCKET_URL=https://api-staging.instasell.com

# Payment Configuration (Test Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# Feature Flags
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DELIVERY_TRACKING=true

# Staging Settings
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=info

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_MAX_FILES_PER_PRODUCT=10

# App Configuration
NEXT_PUBLIC_APP_NAME=InstaSell Staging
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@staging.instasell.com

# Analytics (Staging)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-STAGING-ID