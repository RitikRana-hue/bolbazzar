# Production Environment Configuration
NODE_ENV=production

# API Configuration
NEXT_PUBLIC_API_URL=https://api.instasell.com/api
NEXT_PUBLIC_WS_URL=wss://api.instasell.com
NEXT_PUBLIC_SOCKET_URL=https://api.instasell.com

# Payment Configuration (Live Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# Feature Flags
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DELIVERY_TRACKING=true

# Production Settings
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=error

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_MAX_FILES_PER_PRODUCT=10

# App Configuration
NEXT_PUBLIC_APP_NAME=InstaSell
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@instasell.com

# Analytics (Production)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-PRODUCTION-ID

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.instasell.com
NEXT_PUBLIC_STATIC_URL=https://static.instasell.com