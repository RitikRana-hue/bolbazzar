{
    "name": "instasell-api",
    "version": "1.0.0",
    "description": "InstaSell backend API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
        "dev:staging": "NODE_ENV=staging ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "start:staging": "NODE_ENV=staging node dist/index.js",
        "start:production": "NODE_ENV=production node dist/index.js",
        "test": "NODE_ENV=test jest --coverage",
        "test:watch": "NODE_ENV=test jest --watch",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "seed": "NODE_ENV=development ts-node src/seeds/index.ts",
        "seed:staging": "NODE_ENV=staging ts-node src/seeds/index.ts",
        "migrate": "ts-node src/migrations/run.ts",
        "migrate:staging": "NODE_ENV=staging ts-node src/migrations/run.ts",
        "migrate:production": "NODE_ENV=production ts-node src/migrations/run.ts",
        "db:setup": "../../scripts/setup-database.sh development",
        "db:setup:staging": "../../scripts/setup-database.sh staging",
        "db:setup:production": "../../scripts/setup-database.sh production",
        "db:reset": "../../scripts/setup-database.sh development true --seed",
        "validate": "../../scripts/validate-setup.sh development",
        "validate:staging": "../../scripts/validate-setup.sh staging",
        "validate:production": "../../scripts/validate-setup.sh production",
        "health": "curl -f http://localhost:3001/health || exit 1",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean",
        "postinstall": "echo 'Skipping build for now'"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.948.0",
        "@prisma/client": "^5.22.0",
        "@types/bull": "^3.15.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/pg": "^8.16.0",
        "@types/sharp": "^0.31.1",
        "aws-sdk": "^2.1565.0",
        "axios": "^1.6.5",
        "bcryptjs": "^2.4.3",
        "bull": "^4.11.5",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "file-type": "^16.5.4",
        "helmet": "^7.1.0",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.11",
        "pg": "^8.11.3",
        "prisma": "^5.22.0",
        "redis": "^4.6.12",
        "sharp": "^0.34.5",
        "socket.io": "^4.7.2",
        "stripe": "^14.7.0",
        "uuid": "^9.0.1",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@types/nodemailer": "^7.0.4",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^6.16.0",
        "@typescript-eslint/parser": "^6.16.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prettier": "^3.1.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}
