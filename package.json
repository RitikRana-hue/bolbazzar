{
  "name": "instasell",
  "version": "1.0.0",
  "description": "eBay-style marketplace with real-time auctions",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "seed": "cd database && npm run seed",
    "migrate": "cd database && ./run-migrations-safe.sh",
    "db:setup": "cd database && ./setup-database.sh",
    "db:generate": "cd database && npx prisma generate",
    "db:studio": "cd database && npx prisma studio",
    "docker:build": "cd deployment && docker-compose build",
    "docker:up": "cd deployment && docker-compose up -d",
    "docker:down": "cd deployment && docker-compose down",
    "docker:logs": "cd deployment && docker-compose logs -f",
    "prod:build": "cd deployment && docker-compose -f docker-compose.prod.yml build",
    "prod:up": "cd deployment && docker-compose -f docker-compose.prod.yml up -d",
    "prod:down": "cd deployment && docker-compose -f docker-compose.prod.yml down",
    "prod:logs": "cd deployment && docker-compose -f docker-compose.prod.yml logs -f",
    "health": "curl -f http://localhost:3001/health && curl -f http://localhost:3000",
    "setup": "./scripts/setup-dev.sh",
    "setup:prod": "./scripts/setup-production.sh",
    "deploy": "./deployment/deploy-production.sh"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2"
  }
}