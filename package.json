{
  "name": "instasell",
  "version": "1.0.0",
  "description": "eBay-style marketplace with real-time auctions",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:prod": "cd frontend && NODE_ENV=production npm run build",
    "start": "npm run start --workspace=frontend",
    "start:frontend": "npm run start --workspace=frontend",
    "start:prod": "cd frontend && NODE_ENV=production npm start",
    "test": "npm run test --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspace=frontend",
    "type-check": "npm run type-check --workspace=frontend",
    "analyze": "cd frontend && npm run build && npx @next/bundle-analyzer .next",
    "docker:build": "cd frontend && docker build -f Dockerfile.prod -t instasell:prod .",
    "docker:run": "cd frontend && docker-compose -f docker-compose.prod.yml up -d",
    "docker:stop": "cd frontend && docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "cd frontend && docker-compose -f docker-compose.prod.yml logs -f",
    "deploy:vercel": "cd frontend && vercel --prod",
    "deploy:netlify": "cd frontend && npm run build && netlify deploy --prod --dir=.next",
    "health": "curl -f http://localhost:3000",
    "health:prod": "curl -f https://your-domain.com",
    "build:analyze": "cd frontend && ./scripts/build-prod.sh",
    "deploy": "npm run build:prod && npm run deploy:vercel"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}